{
  "name": "hrouter-market-pulse",
  "version": "1.8.0",
  "description": "Local multi-agent stock trader workbench: A/HK/US paper trading with real quotes and rules, agent-written strategies, hard limits, layered prompts and built-in trader skills — for Claude Code, Codex, Kimi, WorkBuddy and any MCP or ACP agent",
  "homepage": "https://hrouter.net/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/honestTai/hrouter-market-pulse.git"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "bin": {
    "market-pulse": "cli/market-pulse.mjs"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "start": "node mcp/server.bundle.mjs --dashboard",
    "check": "node --check mcp/server.bundle.mjs",
    "smoke": "node scripts/smoke-local.mjs",
    "version": "node scripts/sync-version.mjs",
    "release:pack": "node scripts/package-release.mjs",
    "update:status": "node scripts/updater.mjs status",
    "update:check": "node scripts/updater.mjs check",
    "smoke:updater": "node scripts/smoke-updater.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build:desktop": "npm --prefix desktop run build",
    "setup:futu": "node scripts/setup-futu.mjs",
    "connect": "node scripts/connect-agent.mjs",
    "cli": "node cli/market-pulse.mjs",
    "cli:install": "node cli/market-pulse.mjs install",
    "service:install": "node scripts/arena-service.mjs install",
    "service:status": "node scripts/arena-service.mjs status",
    "service:uninstall": "node scripts/arena-service.mjs uninstall",
    "service:run": "node scripts/arena-service.mjs run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
