{
  "mcpServers": {
    "hrouter_market_pulse": {
      "title": "Hrouter Market Pulse",
      "description": "A-share, Hong Kong and US quotes, evidence, strategies, leakage-aware backtests, risk planning and a multi-agent paper-trading arena.",
      "cwd": ".",
      "command": "node",
      "args": [
        "./mcp/server.bundle.mjs",
        "--stdio"
      ],
      "env_vars": [
        "LOCALAPPDATA",
        "ALL_PROXY",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "HROUTER_REPORT_DIR",
        "HROUTER_REPORT_PORT",
        "HROUTER_WATCHLIST",
        "HROUTER_SEC_USER_AGENT",
        "HROUTER_UPDATE_HOME",
        "XDG_DATA_HOME",
        "HROUTER_FUTU_ENABLED",
        "HROUTER_FUTU_PYTHON",
        "HROUTER_FUTU_PORT",
        "HROUTER_AGENT_ID"
      ],
      "tool_timeout_sec": 120
    }
  }
}
