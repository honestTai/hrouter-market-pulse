{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hrouter.net/schemas/market-pulse/strategy.schema.json",
  "title": "Hrouter Market Pulse Declarative Strategy",
  "type": "object",
  "required": ["name", "version", "rules"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "baseScore": { "type": "number" },
    "minimumScore": { "type": "number" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["feature", "operator", "value", "points", "label"],
        "properties": {
          "feature": {
            "oneOf": [
              { "enum": ["price", "changePct", "rsi14", "volumeRatio20d", "annualizedVolatilityPct", "maxDrawdown60dPct", "priceToSma20Pct", "macdHistogram", "crossCheckDifferencePct"] },
              { "type": "string", "pattern": "^external\\.[A-Za-z][A-Za-z0-9_-]{0,63}$" }
            ]
          },
          "operator": { "enum": ["gt", "gte", "lt", "lte", "between"] },
          "value": { "type": "number" },
          "value2": { "type": "number" },
          "points": { "type": "number", "minimum": -100, "maximum": 100 },
          "label": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
